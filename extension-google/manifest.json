{
  "manifest_version": 3,
  "name": "Remote Chrome Worker",
  "version": "1.0.0",
  "description": "Menerima perintah remote melalui Google Apps Script dan membuka/mengelola tab Chrome.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html"
}