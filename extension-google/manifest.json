{
  "manifest_version": 3,
  "name": "Remote Chrome Worker",
  "version": "1.1.0",
  "description": "Remote Chrome Worker otomatis melalui Google Apps Script.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}
